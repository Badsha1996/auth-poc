ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# *** MY NOTE :  Database (shared with the Next.js app; THIS backend owns the schema via Alembic) ***
# Pooled URL for the running API (Neon: host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Direct URL for Alembic migrations (same host without "-pooler").
MIGRATIONS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Local Docker Postgres, used only by the test suite (pytest forces POSTGRES_DB=user_api_test).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_api

# *** MY NOTE : Auth provider: the backend only VERIFIES tokens, it never logs anyone in ***
# workos | better-auth | jwt. Must equal AUTH_PROVIDER in the Next.js app. Restart after changing.
AUTH_PROVIDER=workos
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# Only with a custom auth domain:
# WORKOS_ISSUER=https://auth.example.com/user_management/client_...
WORKOS_ORGANIZATION_ID=org_...
# Also copy audit events to WorkOS Audit Logs (run scripts/setup_workos_audit_schemas.py first).
WORKOS_AUDIT_LOGS_ENABLED=false

# Better Auth (AUTH_PROVIDER=better-auth): the Next.js app's URL, same as its BETTER_AUTH_URL.
# Keys come from {BETTER_AUTH_URL}/api/auth/jwks; issuer and audience must equal this URL.
# AUTH_PROVIDER=better-auth
# BETTER_AUTH_URL=http://localhost:3000

# Generic JWT provider (AUTH_PROVIDER=jwt) for any other JWT issuer (also used by the test suite):
# JWT_JWKS_URL=https://auth.customer.example/.well-known/jwks.json
# JWT_ISSUER=https://auth.customer.example
# JWT_AUDIENCE=https://api.customer.example

# Break-glass admins (comma-separated): always admin, cannot be demoted from the admin board.
ADMIN_EMAILS=admin@example.com
