# Copy to .env.local and fill in. Never commit real values.

# --- WorkOS AuthKit (Dashboard > API Keys) ---
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# 32+ random characters, e.g. `openssl rand -base64 32`. Encrypts the session cookie.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Must equal the access token "iss" claim (see .well-known/openid-configuration for your client).
WORKOS_ISSUER=https://api.workos.com/user_management/client_...

# --- Auth abstraction: which provider implementation lib/auth uses ---
# workos | better-auth. Must equal AUTH_PROVIDER in the Python API's .env. Restart after changing.
AUTH_PROVIDER=workos

# --- Better Auth (only read when AUTH_PROVIDER=better-auth) ---
# This app's public URL; the Python API's BETTER_AUTH_URL must be the same value.
# BETTER_AUTH_URL=http://localhost:3000
# 32+ random characters, e.g. `openssl rand -base64 32`. Signs cookies and encrypts the JWT signing keys.
# BETTER_AUTH_SECRET=
# Better Auth's own tables. A SEPARATE database from DATABASE_URL (e.g. a second Neon database "auth").
# Create the tables with: npm run auth:migrate
# BETTER_AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/auth?sslmode=require
# Optional sign-in providers. Each button appears only when ALL of its variables are set.
# Register this callback URL with each provider: {BETTER_AUTH_URL}/api/auth/callback/{id}
# (ids: google, microsoft, microsoft-entra-id, github). Development shows what is missing on /auth/sign-in.
#
# Google (Google Cloud Console > Credentials > OAuth client ID > Web application)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Microsoft accounts (Entra admin center > App registrations; button "Continue with Microsoft")
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# common (default) = personal + any work account; organizations = any work account; consumers = personal only
# MICROSOFT_TENANT_ID=common
#
# Microsoft Entra ID, your organisation only (button "Continue with Microsoft Entra ID").
# Can reuse the same app registration as MICROSOFT_* if it allows this tenant; add the second callback URL.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Directory (tenant) ID, a GUID. Not "common".
# ENTRA_TENANT_ID=
#
# GitHub (Settings > Developer settings > OAuth Apps)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Python API (mock-backend-innowhyte) ---
BACKEND_API_URL=http://localhost:8000

# --- Shared Postgres (Neon). Read-only use from Next.js via Prisma; schema owned by Alembic. ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require



MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
